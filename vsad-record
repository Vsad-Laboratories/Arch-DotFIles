#!/usr/bin/env bash
# vsad-record — VSAD Screen Recorder for Niri/Wayland
# MOD+G: toggle recording (focused window)
# MOD+Alt+G: fuzzel menu (choose recording mode)

set -uo pipefail

OUTDIR="$HOME/Videos/Captures"
PID_FILE="/tmp/vsad-record.pid"
WAYBAR_HEIGHT=32
GAPS=12

mkdir -p "$OUTDIR"

notify() {
    command -v dunstify >/dev/null 2>&1 && dunstify -u low "$@" || notify-send -u low "$@"
}

signal_waybar() {
    pkill -SIGRTMIN+1 waybar 2>/dev/null || true
}

is_recording() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
        return 0
    else
        rm -f "$PID_FILE"
        return 1
    fi
}

stop_recording() {
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PID_FILE"
        return 1
    fi
    kill -INT "$pid" 2>/dev/null
    local waited=0
    while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do
        sleep 0.1
        waited=$((waited + 1))
    done
    kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null
    rm -f "$PID_FILE"

    local latest
    latest=$(ls -t "$OUTDIR"/recording_* 2>/dev/null | head -1)
    local size=$(stat -c%s "$latest" 2>/dev/null || echo 0)
    if [[ "$size" -gt 1000 ]]; then
        local mins=$(($(date +%s) - $(stat -c%Y "$latest")))
        notify "Recording Stopped" "$(basename "$latest")" -t 3000
    else
        notify "Recording Stopped" "File too small, discarding" -t 2000
        rm -f "$latest" 2>/dev/null
    fi
    signal_waybar
}

get_focused_geometry() {
    local win
    win=$(niri msg --json focused-window 2>/dev/null) || { echo ""; return; }
    [[ "$win" == "null" || -z "$win" ]] && { echo ""; return; }
    local w h
    w=$(echo "$win" | jq -r '.layout.window_size[0] // .layout.tile_size[0]')
    h=$(echo "$win" | jq -r '.layout.window_size[1] // .layout.tile_size[1]')
    [[ -z "$w" || "$w" == "null" || "$w" == "0" ]] && { echo ""; return; }
    echo "$GAPS,$((WAYBAR_HEIGHT + GAPS)) ${w}x${h}"
}

start_recording() {
    local geometry="$1"
    local label="$2"

    TIMESTAMP=$(date +'%Y-%m-%d_%H-%M-%S')
    OUTPUT="$OUTDIR/recording_${TIMESTAMP}.mp4"

    ARGS=(-f "$OUTPUT" -c libx264 -r 30 --pixel-format yuv420p)
    [[ -n "$geometry" ]] && ARGS+=(-g "$geometry")

    setsid wf-recorder "${ARGS[@]}" </dev/null >/dev/null 2>&1 &
    RECORDER_PID=$!
    echo "$RECORDER_PID" > "$PID_FILE"

    sleep 1
    if kill -0 "$RECORDER_PID" 2>/dev/null; then
        notify "Recording Started" "$label — MOD+G to stop" -t 2000
        signal_waybar
    else
        rm -f "$PID_FILE"
        notify "Recording Failed" "Could not start" -t 3000
        exit 1
    fi
}

# Check dependencies
command -v wf-recorder >/dev/null || { notify "Missing" "wf-recorder"; exit 1; }
command -v jq >/dev/null || { notify "Missing" "jq"; exit 1; }

# Toggle: stop if already recording
if is_recording; then
    stop_recording
    exit 0
fi

# MOD+Alt+G: show fuzzel menu
if [[ "${1:-}" == "--menu" ]]; then
    command -v fuzzel >/dev/null || { notify "Missing" "fuzzel"; exit 1; }

    CHOSEN=$(printf "Focused Window\nScreen Region\nFull Screen" | \
        fuzzel --dmenu --prompt="Record → " --width=30 --lines=5 2>/dev/null) || exit 0
    [[ -z "$CHOSEN" ]] && exit 0

    case "$CHOSEN" in
        *"Focused Window"*)
            GEOMETRY=$(get_focused_geometry)
            start_recording "$GEOMETRY" "Focused Window"
            ;;
        *"Screen Region"*)
            command -v slurp >/dev/null || { notify "Missing" "slurp"; exit 1; }
            GEOMETRY=$(slurp 2>/dev/null) || exit 0
            [[ -z "$GEOMETRY" ]] && exit 0
            start_recording "$GEOMETRY" "Screen Region"
            ;;
        *"Full Screen"*)
            start_recording "" "Full Screen"
            ;;
    esac
    exit 0
fi

# Default (MOD+G): record focused window
GEOMETRY=$(get_focused_geometry)
start_recording "$GEOMETRY" "Focused Window"
