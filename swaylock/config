# VSAD Swaylock — Aesthetic Lockscreen

# Wallpaper
image=~/.config/wallpaper-lock.png
scaling-type=fill

# Appearance
color=000000
font=Maple Mono NF
font-size=32

# Ring
ring-color=333333
ring-ver-color=5fff87
ring-wrong-color=ff5f5f
ring-clear-color=ffff87
ring-radius=90
ring-thickness=8

# Text
text-color=ffffff
text-ver-color=5fff87
text-wrong-color=ff5f5f
text-clear-color=ffff87

# Key
key-hl-color=5fff87
bs-hl-color=ff5f5f

# Line
line-color=000000
line-ver-color=000000
line-wrong-color=000000
line-clear-color=000000

# Inside
inside-color=111111
inside-ver-color=111111
inside-wrong-color=111111
inside-clear-color=111111

# Border
border-color=222222
border-ver-color=5fff87
border-wrong-color=ff5f5f
border-clear-color=ffff87

# Behavior
ignore-empty-password
show-failed-attempts
indicator-radius=90
indicator-thickness=8
