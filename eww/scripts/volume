#!/usr/bin/env bash
# volume - Get volume status
while true; do
    vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -oP "\K[0-9.]+" | head -1)
    muted=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && echo "1" || echo "0")
    vol_pct=$(echo "$vol * 100" | bc 2>/dev/null || echo "0")
    echo "${vol_pct}|${muted}"
    sleep 1
done
