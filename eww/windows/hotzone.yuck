(defwindow hotzone
  :stacking "bg"
  :geometry
    (geometry
      :x "0"
      :y "0"
      :width "100%"
      :height "4px"
      :anchor "top left"
    )
  :reserve (strat "center" "top" "4px")
  :exclusive false
  :focusable false
  :monitor 0
  (eventbox :onhover "eww open top-hud --duration 3000" ""))
