// VSAD Niri — Appearance + Layout
// VantaBlack visual language

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    struts {
        top 0
    }

    focus-ring {
        width 0
        active-color "rgba(0,0,0,0)"
        inactive-color "rgba(0,0,0,0)"
    }

    border {
        off
    }

    shadow {
        off
    }

    default-column-display "normal"
}

// Make all windows transparent — no background drawn behind them
window-rule {
    draw-border-with-background false
}
