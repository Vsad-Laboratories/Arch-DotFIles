// VSAD Niri — Layout
// Gaps, column widths, struts

layout {
    gaps 8
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Top strut: 0 — Waybar reserves its own space via layer-shell
    struts {
        top 0
    }
}
