// VSAD Niri — Animations
// Smooth, minimal, professional

animations {
    slowdown 0.8

    // Window open: smooth fade-in scale
    window-open {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 250
    }

    // Window close: quick fade-out
    window-close {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 200
    }

    // Window movement: smooth slide
    window-movement {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 200
    }

    // Window resize: smooth
    window-resize {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 150
    }

    // Workspace switch: smooth slide
    workspace-switch {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 300
    }

    // Overview: zoom out/in
    overview-open-close {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 300
    }

    // Config notification
    config-notification-open-close {
        curve "cubic-bezier" 0.22 1.0 0.36 1.0
        duration-ms 200
    }
}
