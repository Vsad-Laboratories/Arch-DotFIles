// VSAD Niri — Startup Processes

// Main startup script
spawn-sh-at-startup "~/.config/niri/scripts/startup.sh"

// Boot State: Workspace 1 (System) - Kitty with btop
spawn-at-startup "kitty" "--class" "btop" "-e" "btop"

// Boot State: Workspace 2 (Main) - Clean terminal
spawn-at-startup "kitty"

// Focus Workspace 2 after boot
spawn-sh-at-startup "sleep 2 && niri msg action focus-workspace 2"
