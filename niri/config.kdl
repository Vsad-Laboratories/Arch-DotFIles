// VSAD Niri — Configuration Controller
// Aerospace Desktop Environment — Wayland/Niri
//
// This file is the entry point. It includes modular configuration files.
// Do not put detailed configuration here — use the modules/ and ui/ directories.
// ==================== Global Settings ====================

// Named workspaces
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"

prefer-no-csd

// Screenshot path
screenshot-path "~/Pictures/ScreenShots/screenshot_%Y-%m-%d_%H-%M-%S.png"

// Skip the hotkey overlay popup at startup
hotkey-overlay {
    skip-at-startup
}

// Cursor size
cursor {
    xcursor-size 24
}

// ==================== Modules ====================
include "modules/input.kdl"
include "modules/keybinds.kdl"
include "modules/rules.kdl"
include "modules/startup.kdl"

// ==================== UI ====================
include "ui/appearance.kdl"
include "ui/layout.kdl"
include "ui/animations.kdl"
